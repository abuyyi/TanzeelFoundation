# ===========================================================================
# Production environment template for Tanzeel Foundation
# Copy this file to `.env` on the server and fill in real values.
# `.env` is gitignored and must NEVER be committed.
# ===========================================================================

# --- Django core ---
DJANGO_DEBUG=False
# Generate a fresh key:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
DJANGO_ALLOWED_HOSTS=tanzeelfoundation.co.tz,www.tanzeelfoundation.co.tz
# Optional; auto-derived as https://<each non-local ALLOWED_HOST> if omitted.
DJANGO_CSRF_TRUSTED_ORIGINS=https://tanzeelfoundation.co.tz,https://www.tanzeelfoundation.co.tz

# --- HTTPS / security hardening (only applied when DJANGO_DEBUG=False) ---
# Set SSL_REDIRECT to False only if the host/proxy already forces HTTPS.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

# --- Database (cPanel MySQL) ---
# On cPanel the DB name and user are usually prefixed, e.g. cpaneluser_tanzeel_db
MYSQL_DATABASE=cpaneluser_tanzeel_db
MYSQL_USER=cpaneluser_tanzeel
MYSQL_PASSWORD=CHANGE_ME
MYSQL_HOST=localhost
MYSQL_PORT=3306

# --- Logging ---
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FILE_LEVEL=INFO
DJANGO_REQUEST_LOG_LEVEL=WARNING

# --- Pesapal (from your Pesapal merchant dashboard) ---
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_TOKEN_URL=https://pay.pesapal.com/v3/api/Auth/RequestToken
PESAPAL_SUBMIT_URL=https://pay.pesapal.com/v3/api/Transactions/SubmitOrderRequest
PESAPAL_REGISTER_IPN_URL=https://pay.pesapal.com/v3/api/URLSetup/RegisterIPN
PESAPAL_CURRENCY=TZS

# --- AzamPay (rotate any previously committed credentials before using) ---
AZAMPAY_AUTH_BASE_URL=https://authenticator.azampay.co.tz
AZAMPAY_CHECKOUT_BASE_URL=https://checkout.azampay.co.tz
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
AZAMPAY_API_KEY=
AZAMPAY_DEFAULT_PROVIDER=Mpesa
AZAMPAY_CURRENCY=TZS
AZAMPAY_PUBLIC_BASE_URL=https://tanzeelfoundation.co.tz
AZAMPAY_MOCK_MODE=False
# Webhook verification (configure at least one for production)
AZAMPAY_WEBHOOK_PUBLIC_KEY=
AZAMPAY_WEBHOOK_TOKEN=
AZAMPAY_CHECKSUM_SECRET=
