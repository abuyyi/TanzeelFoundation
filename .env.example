DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_LOG_LEVEL=DEBUG
DJANGO_LOG_FILE_LEVEL=DEBUG
DJANGO_REQUEST_LOG_LEVEL=WARNING

AZAMPAY_AUTH_BASE_URL=https://authenticator-sandbox.azampay.co.tz
AZAMPAY_CHECKOUT_BASE_URL=https://sandbox.azampay.co.tz
AZAMPAY_APP_NAME=your-app-name
AZAMPAY_CLIENT_ID=your-client-id
AZAMPAY_CLIENT_SECRET=your-client-secret
AZAMPAY_API_KEY=your-api-key
AZAMPAY_DEFAULT_PROVIDER=Mpesa
AZAMPAY_CURRENCY=TZS
AZAMPAY_TIMEOUT=15
AZAMPAY_AUTH_TIMEOUT=10
AZAMPAY_CHECKOUT_TIMEOUT=15
AZAMPAY_TOKEN_CACHE_KEY=azampay:access-token
AZAMPAY_TOKEN_CACHE_TTL=3300
AZAMPAY_PAYMENT_RATE_LIMIT_COUNT=5
AZAMPAY_PAYMENT_RATE_LIMIT_WINDOW=300
AZAMPAY_WEBHOOK_RATE_LIMIT_COUNT=60
AZAMPAY_WEBHOOK_RATE_LIMIT_WINDOW=60
AZAMPAY_MAX_INITIATION_RETRIES=3
AZAMPAY_INITIAL_RETRY_DELAY_SECONDS=10
AZAMPAY_PENDING_STALE_AFTER_SECONDS=120
AZAMPAY_DUPLICATE_ATTEMPT_WINDOW_SECONDS=180

# Optional if AzamPay requires checksum headers for your account/environment
AZAMPAY_CHECKSUM_SECRET=
AZAMPAY_CHECKSUM_HEADER=X-Checksum

# Configure at least one webhook verification method for non-debug environments
AZAMPAY_WEBHOOK_PUBLIC_KEY=
AZAMPAY_WEBHOOK_TOKEN=
AZAMPAY_WEBHOOK_SIGNATURE_HEADER=X-AzamPay-Signature
AZAMPAY_WEBHOOK_TIMESTAMP_HEADER=X-AzamPay-Timestamp
AZAMPAY_WEBHOOK_TOKEN_HEADER=X-AzamPay-Webhook-Token
AZAMPAY_WEBHOOK_MAX_AGE_SECONDS=300
AZAMPAY_PUBLIC_BASE_URL=https://your-public-domain-or-ngrok-url
